<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the external checkers (T-049): CytoGPS adapter with a fake process runner, and an
       integration test against the local CytoGPS build (skips when config/local.yaml has no cytogps setup). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CytoLex.External/CytoLex.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Batch sample files (T-038; generated by `kb samples`), loaded by path from data/batch/. -->
    <None Include="$(RepoRoot)tests/data/batch/**" LinkBase="data/batch" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
