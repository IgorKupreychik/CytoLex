<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:cmp="using:CytoLex.External.Comparison"
        xmlns:vm="using:CytoLex.Desktop.ViewModels"
        xmlns:rules="using:CytoLex.Desktop.Rules"
        xmlns:hl="using:CytoLex.Desktop.Highlighting"
        xmlns:ideo="using:CytoLex.Desktop.Ideograms"
        xmlns:ext="using:CytoLex.External"
        x:Class="CytoLex.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CytoLex"
        Icon="/Assets/cytolex.ico"
        Width="1000" Height="680">
  <!-- Main tabs: single-string check (T-036), batch validation (T-038), rule browser (T-039), bands (T-084), settings (T-089) -->
  <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedMainTab}" Margin="8,4,8,8">
  <TabItem Header="Single string">
  <DockPanel Margin="8">
    <!-- Input -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="ISCN string" FontWeight="SemiBold" VerticalAlignment="Center" />
      <!-- Autocorrection (T-097): meaning-preserving fixes of the rules the KB flags with fix.auto; the editor keeps the typed text -->
      <CheckBox Grid.Column="3" Content="Autocorrect" IsChecked="{Binding AutoCorrect}" Margin="8,0,0,0"
                ToolTip.Tip="Correct stray spaces and letter case (KB rules with fix.auto); the typed text is kept" />
      <!-- Edition selector (T-037): one edition or all editions (one tab each) -->
      <ComboBox Grid.Column="1" x:Name="EditionSelector" MinWidth="220" Margin="0,0,8,0"
                ToolTip.Tip="ISCN edition to validate against"
                ItemsSource="{Binding EditionChoices}" SelectedItem="{Binding SelectedEditionChoice}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EditionChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="2" PlaceholderText="Book examples" MinWidth="240"
                ItemsSource="{x:Static vm:MainWindowViewModel.ExampleStrings}"
                SelectedItem="{Binding SelectedExample}" />
    </Grid>
    <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="4">
      <ae:TextEditor x:Name="Input" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="18"
                     ShowLineNumbers="False" WordWrap="True" MinHeight="32"
                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <!-- Underlined homologue (T-042): U+0332 after each underlined character -->
        <ae:TextEditor.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Underline homologue" InputGesture="Ctrl+U" Click="OnUnderlineClick" />
            <Separator />
            <MenuItem Header="Cut" InputGesture="Ctrl+X" Click="OnCutClick" />
            <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopyClick" />
            <MenuItem Header="Paste" InputGesture="Ctrl+V" Click="OnPasteClick" />
          </ContextMenu>
        </ae:TextEditor.ContextMenu>
      </ae:TextEditor>
    </Border>

    <!-- Corrected line (T-097): the selected edition's corrected string with one note per correction -->
    <Border DockPanel.Dock="Top" Classes="corrected" IsVisible="{Binding SelectedPanel.HasCorrection, FallbackValue=False}"
            Margin="0,4,0,0">
      <StackPanel Spacing="2">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="Corrected:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedPanel.Corrected}" FontFamily="Cascadia Mono,Consolas,monospace"
                               FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Content="Copy" Click="OnCopyCorrected" Padding="8,1" Margin="8,0,0,0"
                  ToolTip.Tip="Copy the corrected string" />
          <Button Grid.Column="3" Content="Use corrected" Command="{Binding UseCorrectedCommand}" Padding="8,1" Margin="6,0,0,0"
                  ToolTip.Tip="Replace the input with the corrected string (Ctrl+Z undoes it)" />
        </Grid>
        <ItemsControl ItemsSource="{Binding SelectedPanel.Corrections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CorrectionItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="link" Content="{Binding RuleId}" Command="{Binding OpenRuleCommand}"
                        ToolTip.Tip="Open the rule in the rule browser" />
                <TextBlock Text="{Binding Change}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Description}" VerticalAlignment="Center" Opacity="0.85" />
                <TextBlock Text="{Binding Citation}" IsVisible="{Binding HasCitation}" VerticalAlignment="Center"
                           FontStyle="Italic" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Status -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.7" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastApplied}" IsVisible="{Binding HasLastApplied}" Margin="0,8,0,0"
               ToolTip.Tip="Ctrl+Z in the input undoes it" />

    <!-- Shared: context (the same in every edition), or the placeholder for blank input -->
    <TextBlock DockPanel.Dock="Top" Text="{Binding Placeholder}" Margin="0,10,0,0" Opacity="0.7" IsVisible="{Binding !HasResult}" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding ContextText}" Margin="0,10,0,6" Opacity="0.8" TextWrapping="Wrap"
               IsVisible="{Binding HasResult}" />

    <!-- Edition chips (T-098): one per validated edition with its verdict; the selected one drives the views and the highlights -->
    <ListBox DockPanel.Dock="Top" Classes="chips" ItemsSource="{Binding Panels}" SelectedItem="{Binding SelectedPanel}"
             IsVisible="{Binding HasResult}" Margin="0,0,0,4">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EditionPanelViewModel">
          <TextBlock Text="{Binding ChipText}" FontSize="14" ToolTip.Tip="{Binding ChipTip}"
                     Classes.valid="{Binding IsValidAsWritten}" Classes.autocorrected="{Binding IsAutoCorrected}" Classes.invalid="{Binding IsInvalid}" Classes.notimpl="{Binding IsNotImplemented}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Full-width view tabs of the selected edition (T-098): Diagnostics (default) | Abnormalities | Translation | CytoGPS -->
    <TabControl x:Name="ViewTabs" SelectedIndex="{Binding SelectedViewIndex}" IsVisible="{Binding HasResult}" Padding="0,6,0,0">
      <TabItem Header="{Binding SelectedPanel.DiagnosticsHeader, FallbackValue=Diagnostics}">
        <DockPanel DataContext="{Binding SelectedPanel}" x:DataType="vm:EditionPanelViewModel">
          <StackPanel DockPanel.Dock="Top" Margin="0,4,0,10" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding ValidityText}" FontWeight="SemiBold" FontSize="15"
                         Classes.valid="{Binding IsValidAsWritten}" Classes.autocorrected="{Binding IsAutoCorrected}" Classes.invalid="{Binding IsInvalid}" Classes.notimpl="{Binding IsNotImplemented}" />
              <TextBlock Text="{Binding CountsText}" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
            <!-- Fix all (T-040): one previewed round of every applicable fix -->
            <Border IsVisible="{Binding HasFixAll}" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,4">
              <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Content="{Binding FixAll.Header}" Command="{Binding FixAll.ApplyCommand}"
                        ToolTip.Tip="{Binding FixAll.Tip}" Padding="10,2" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding FixAll.DiffParts}" VerticalAlignment="Center"
                              ItemTemplate="{StaticResource DiffPartTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Segments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SegmentItemViewModel">
                  <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" />
                      <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontStyle="Italic" Opacity="0.7" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Classes="panel" IsVisible="{Binding IsImplemented}">
          <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="No findings." IsVisible="{Binding !HasDiagnostics}" Margin="10,6" Opacity="0.6" />
          <ListBox ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Grid.Column="0" Background="{Binding SeverityBrush}" CornerRadius="3" Padding="6,1"
                          VerticalAlignment="Top" Margin="0,0,10,0" MinWidth="64">
                    <TextBlock Text="{Binding SeverityLabel}" Foreground="White" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Location}" FontFamily="Cascadia Mono,Consolas,monospace" Opacity="0.7" />
                    </StackPanel>
                    <!-- Rule ID: a link to the rule browser for KB rules (T-039), plain text for core codes -->
                    <Button Classes="link" Content="{Binding RuleId}" IsVisible="{Binding HasKbRule}" Click="OnOpenRuleClick"
                            ToolTip.Tip="Open the rule in the rule browser" />
                    <TextBlock Text="{Binding RuleId}" IsVisible="{Binding IsCoreCode}"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Condition}" IsVisible="{Binding HasCondition}" TextWrapping="Wrap" FontStyle="Italic" />
                    <TextBlock Text="{Binding Review}" IsVisible="{Binding HasReview}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
                    <!-- Fixes (T-040): a level-1 fix or a "did you mean" option (T-041) as a before/after diff with Apply; an explanation as text -->
                    <ItemsControl ItemsSource="{Binding Fixes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FixItemViewModel">
                          <StackPanel Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Opacity="0.9" />
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsEdit}">
                              <Button Grid.Column="0" Content="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}"
                                      Padding="10,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding Preview, StringFormat='Change the input to: {0}'}" />
                              <ItemsControl Grid.Column="1" ItemsSource="{Binding DiffParts}" VerticalAlignment="Center"
                                            ItemTemplate="{StaticResource DiffPartTemplate}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                              </ItemsControl>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Citations}" IsVisible="{Binding HasCitations}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="{Binding SelectedPanel.AbnormalitiesHeader, FallbackValue=Abnormalities}">
        <Panel DataContext="{Binding SelectedPanel}" x:DataType="vm:EditionPanelViewModel">
          <TextBlock Text="{Binding NotImplementedText}" IsVisible="{Binding IsNotImplemented}" Opacity="0.6" Margin="0,6" />
          <DockPanel IsVisible="{Binding IsImplemented}" Margin="0,6,0,0">
            <TextBlock DockPanel.Dock="Top" Text="No karyotype cell lines, in situ or array results." Opacity="0.6"
                       IsVisible="{Binding !HasCellLines}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding CellLineGroups}" Margin="0,0,14,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CellLineGroupViewModel">
                    <StackPanel Spacing="4" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Opacity="0.85" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasFullForm}"
                            ToolTip.Tip="The cell line written out without idem/sl/sdl: inherited and own changes in ISCN §6 order">
                        <TextBlock Grid.Column="0" Text="Full form:" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding FullForm}" TextWrapping="Wrap" VerticalAlignment="Center"
                                             FontFamily="Cascadia Mono,Consolas,monospace" />
                        <Button Grid.Column="2" Content="Copy" Click="OnCopyFullForm" Padding="8,2" Margin="6,0,0,0"
                                ToolTip.Tip="Copy the full form" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AbnormalityItemViewModel">
                            <Border Classes="card" Classes.marked="{Binding IsMarked}" Opacity="{Binding Opacity}"
                                    Tapped="OnSpanItemTapped" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                              <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                  <Border Grid.Column="0" Background="{Binding KindBrush}" CornerRadius="3" Padding="6,1"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding KindLabel}" Foreground="White" FontSize="12" />
                                  </Border>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ShortForm}" IsVisible="{Binding ShowShortForm}" Opacity="0.65"
                                               FontFamily="Cascadia Mono,Consolas,monospace" />
                                  </StackPanel>
                                  <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{Binding DiagnosticsBrush}"
                                           IsVisible="{Binding HasDiagnostics}" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding DiagnosticsTip}" />
                                  <Button Grid.Column="3" Content="Map" Click="OnShowOnMap" IsVisible="{Binding IsOnMap}"
                                          Padding="6,0" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                          ToolTip.Tip="Show its loci on the Map" />
                                </Grid>
                                <TextBlock Text="{Binding Detailed}" IsVisible="{Binding ShowDetailed}" Opacity="0.65" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           ToolTip.Tip="Detailed system: the band composition from the short-arm end (ISCN §4.3.2)" />
                                <TextBlock Text="{Binding PositionsText}" IsVisible="{Binding HasPositions}" Opacity="0.65" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           ToolTip.Tip="Nucleotide positions in the stated genome build (ISCN §14.2)" />
                                <TextBlock Text="{Binding LociText}" IsVisible="{Binding HasLoci}" Opacity="0.65" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           ToolTip.Tip="Loci with their status and signal counts (ISCN §13.2–13.3)" />
                                <ItemsControl ItemsSource="{Binding Tags}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <Border Classes="tag">
                                        <TextBlock Text="{Binding}" FontSize="11" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Flags}" IsVisible="{Binding HasFlags}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FlagViewModel">
                                      <Border Classes="flag" ToolTip.Tip="{Binding Tip}">
                                        <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="SemiBold" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="{Binding PartsHeader}" IsVisible="{Binding HasParts}" Padding="4">
                                  <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:AbnormalityPartViewModel">
                                        <Border Classes="part" Tapped="OnSpanItemTapped">
                                          <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                              <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" />
                                              <TextBlock Text="{Binding ShortForm}" Opacity="0.65" FontFamily="Cascadia Mono,Consolas,monospace" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TagsText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Expander>
                                <Expander IsVisible="{Binding HasReference}" Padding="4"
                                          IsExpanded="{Binding Reference.IsExpanded, FallbackValue=False}"
                                          Header="{Binding Reference.Label, FallbackValue=''}">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Reference.TargetText, FallbackValue=''}" IsVisible="{Binding Reference.HasTarget, FallbackValue=False}"
                                               Opacity="0.65" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" />
                                    <TextBlock Text="{Binding Reference.InheritedHeader, FallbackValue=''}" FontSize="11" Opacity="0.7" />
                                    <ItemsControl ItemsSource="{Binding Reference.Inherited, FallbackValue={x:Null}}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InheritedItemViewModel">
                                          <Border Classes="part" Opacity="0.6" Tapped="OnSpanItemTapped" ToolTip.Tip="{Binding RemovedTip}"
                                                  PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                              <TextBlock Text="{Binding Text}" IsVisible="{Binding IsKept}" FontFamily="Cascadia Mono,Consolas,monospace" />
                                              <TextBlock Text="{Binding Text}" IsVisible="{Binding IsRemoved}" TextDecorations="Strikethrough"
                                                         FontFamily="Cascadia Mono,Consolas,monospace" />
                                              <TextBlock Text="{Binding ShortForm}" IsVisible="{Binding ShowShortForm}" Opacity="0.65"
                                                         FontFamily="Cascadia Mono,Consolas,monospace" />
                                              <Border Classes="tag">
                                                <TextBlock Text="{Binding Tag}" FontSize="11" />
                                              </Border>
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </TabItem>
      <TabItem Header="Translation">
        <Panel DataContext="{Binding SelectedPanel}" x:DataType="vm:EditionPanelViewModel">
          <TextBlock Text="{Binding NotImplementedText}" IsVisible="{Binding IsNotImplemented}" Opacity="0.6" Margin="0,6" />
          <DockPanel IsVisible="{Binding IsImplemented}" Margin="0,6,0,0">
            <!-- Options shared by every edition: coordinates toggle + build -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
              <CheckBox Content="Genomic coordinates" FontSize="13"
                        IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowCoordinates}"
                        ToolTip.Tip="Approximate base-pair positions of the named bands on the reference genome and segment sizes (NCBI/UCSC band data; band edges are estimates)" />
              <ComboBox FontSize="13" MinWidth="100"
                        IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowCoordinates}"
                        ItemsSource="{x:Static vm:MainWindowViewModel.CoordinateBuilds}"
                        SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedCoordinateBuild}"
                        ToolTip.Tip="Genome build of the coordinates">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CoordinateBuildChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="No translation for this edition." Opacity="0.6" FontSize="13"
                       IsVisible="{Binding !HasTranslation}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasTranslation}">
              <StackPanel Spacing="6" Margin="0,0,14,8" DataContext="{Binding Translation}" x:DataType="vm:TranslationViewModel">
                <Border Classes="banner" IsVisible="{Binding HasBanner}">
                  <TextBlock Text="{Binding Banner}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
                </Border>
                <TextBlock Text="{Binding DraftNote}" IsVisible="{Binding HasDraftNote}" FontSize="11" FontStyle="Italic"
                           Opacity="0.65" TextWrapping="Wrap" ToolTip.Tip="The wording is reviewed in task T-082" />
                <TextBlock Text="{Binding ReadingBasisText}" IsVisible="{Binding HasReadingBasisText}" FontSize="12"
                           Opacity="0.75" TextWrapping="Wrap" />
                <ContentControl Content="{Binding Summary}" ContentTemplate="{StaticResource TranslationItemTemplate}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TranslationItemTemplate}" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </TabItem>
      <!-- Map (T-101): ideograms (850 level) with the loci of the string; links both ways with the editor and the cards -->
      <TabItem Header="{Binding SelectedPanel.MapHeader, FallbackValue=Map}">
        <Panel DataContext="{Binding SelectedPanel}" x:DataType="vm:EditionPanelViewModel">
          <TextBlock Text="{Binding NotImplementedText}" IsVisible="{Binding IsNotImplemented}" Opacity="0.6" Margin="0,6" />
          <Panel IsVisible="{Binding IsImplemented}">
            <DockPanel Margin="0,6,0,0" DataContext="{Binding Map}" x:DataType="vm:MapViewModel">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                <CheckBox Content="All chromosomes" FontSize="13" IsChecked="{Binding ShowAllChromosomes}"
                          ToolTip.Tip="Draw all 24 chromosomes, or only those with loci" />
                <ComboBox FontSize="13" MinWidth="100"
                          ItemsSource="{x:Static vm:MainWindowViewModel.CoordinateBuilds}"
                          SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedCoordinateBuild}"
                          ToolTip.Tip="Genome build the loci are placed in (band coordinates from NCBI/UCSC; arr positions as written)">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoordinateBuildChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="850-band ideograms · gain/loss only where the symbol states it (del, dup, +/–) · arr copy numbers as written"
                           FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="No band data for this edition." Opacity="0.6" IsVisible="{Binding !HasBands}" />
              <!-- Locus list (right) -->
              <Border DockPanel.Dock="Right" Width="300" Margin="8,0,0,0" Classes="panel">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="6" Spacing="2">
                    <TextBlock Text="No loci in this string." Opacity="0.6" IsVisible="{Binding !HasLoci}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Loci}" ItemTemplate="{StaticResource LocusRowTemplate}" />
                    <TextBlock Text="{Binding UnplacedHeader}" IsVisible="{Binding HasUnplaced}" FontWeight="SemiBold" Opacity="0.85"
                               Margin="0,8,0,2" TextWrapping="Wrap" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding Unplaced}" ItemTemplate="{StaticResource LocusRowTemplate}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <!-- Ideograms -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Chromosomes}" Margin="0,0,8,8">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IdeogramChromosomeViewModel">
                      <ideo:IdeogramView Chromosome="{Binding}" MaxBodyHeight="280" Margin="2,0,2,10" Cursor="Hand" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Panel>
        </Panel>
      </TabItem>
      <!-- CytoGPS (T-081): on demand, in the background; its result never changes the CytoLex views -->
      <TabItem Header="{Binding CytoGps.Header}">
        <Panel DataContext="{Binding CytoGps}" x:DataType="vm:CytoGpsPanelViewModel">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,6,14,8" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check with CytoGPS" Command="{Binding CheckCommand}"
                        ToolTip.Tip="Runs the local CytoGPS build on this string (ISCN 2016; one Java process per check)" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                <CheckBox Content="Check automatically after typing" IsChecked="{Binding IsAutoCheck}"
                          IsEnabled="{Binding IsConfigured}" VerticalAlignment="Center"
                          ToolTip.Tip="Starts a check after a short pause in typing; a new input cancels the running check" />
              </StackPanel>
              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                         Classes.valid="{Binding IsValid}" Classes.invalid="{Binding IsInvalid}" Classes.notimpl="{Binding IsNotImplemented}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsNotConfigured}">
                <Button Content="Set up…" Click="OnOpenSettings"
                        ToolTip.Tip="Opens the Settings tab: CytoGPS paths, cache and time limit (config/local.yaml)" />
                <TextBlock Text="{x:Static vm:CytoGpsPanelViewModel.SetupPointer}" Opacity="0.8" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding IsRunning}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              <Border Classes="banner" IsVisible="{Binding IsUnsupported}">
                <TextBlock Text="{Binding UnsupportedText}" TextWrapping="Wrap" FontSize="13" />
              </Border>
              <Border Classes="agreement" Classes.agree="{Binding IsAgreeing}" Classes.disagree="{Binding IsDisagreeing}"
                      IsVisible="{Binding HasAgreement}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding AgreementText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </Border>
              <SelectableTextBlock Text="{Binding FailureText}" IsVisible="{Binding HasFailure}" Foreground="#D13438"
                                   TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasToolStatus}">
                <TextBlock Text="CytoGPS status" Opacity="0.7" Width="130" />
                <SelectableTextBlock Text="{Binding ToolStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSentInput}">
                <TextBlock Text="Sent as" Opacity="0.7" Width="130" VerticalAlignment="Center"
                           ToolTip.Tip="The string as sent to CytoGPS: printed symbols in their typed ASCII forms" />
                <SelectableTextBlock Text="{Binding SentInput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="14" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasRevisedInput}">
                <TextBlock Text="Repaired by CytoGPS" Opacity="0.7" Width="130" VerticalAlignment="Center" />
                <SelectableTextBlock Text="{Binding RevisedInput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="14" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="Messages" FontWeight="SemiBold" IsVisible="{Binding HasMessages}" Margin="0,4,0,0" />
              <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ext:ExternalMessage">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                      <Border Classes="tag" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Kind}" FontSize="11" />
                      </Border>
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </TabItem>
    </TabControl>
  </DockPanel>
  </TabItem>

  <TabItem Header="Batch">
    <DockPanel Margin="8" DataContext="{Binding Batch}" x:DataType="vm:BatchViewModel">
      <!-- File, edition, run -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <Button Content="Open file…" Click="OnOpenBatchFile" IsEnabled="{Binding !IsRunning}" />
        <ComboBox MinWidth="220" ToolTip.Tip="ISCN edition to validate against"
                  ItemsSource="{Binding EditionChoices}" SelectedItem="{Binding SelectedEditionChoice}"
                  IsEnabled="{Binding !IsRunning}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EditionChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="Autocorrect" IsChecked="{Binding AutoCorrect}" IsEnabled="{Binding !IsRunning}"
                  ToolTip.Tip="Correct stray spaces and letter case (KB rules with fix.auto) before judging; the original is kept" />
        <Button Content="Run" Command="{Binding RunCommand}" />
        <Button Content="Cancel" Command="{Binding RunCancelCommand}" IsVisible="{Binding IsRunning}" />
        <Button Content="Export CSV…" Click="OnExportBatchCsv" IsEnabled="{Binding CanExport}"
                ToolTip.Tip="Summary: one row per string and edition" />
        <Button Content="Export JSON…" Click="OnExportBatchJson" IsEnabled="{Binding CanExport}"
                ToolTip.Tip="Full reports: diagnostics, citations, fixes, abnormalities" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Top" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}"
                   IsVisible="{Binding IsRunning}" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,6" />
      <!-- Comparison with CytoGPS (T-052): never blocks the batch; says why CytoGPS results are missing -->
      <Border DockPanel.Dock="Top" DataContext="{Binding Comparison}" x:DataType="vm:ComparisonViewModel"
              BorderBrush="Gray" BorderThickness="0,1,0,1" Padding="0,6" Margin="0,0,0,8">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding CompareText}" Command="{Binding CompareCommand}"
                    ToolTip.Tip="Runs CytoLex and CytoGPS on the loaded strings in the CytoGPS edition and compares their verdicts; with Autocorrect ticked, strings valid after autocorrection count as valid for CytoLex (CytoGPS gets them as written)" />
            <Button Content="Cancel" Command="{Binding CompareCancelCommand}" IsVisible="{Binding IsRunning}" />
            <Button Content="Export report…" Click="OnExportComparisonReport" IsEnabled="{Binding HasResult}"
                    ToolTip.Tip="Markdown, CSV, triage draft and KB-example draft into a folder" />
          </StackPanel>
          <!-- Triage file on its own row so its buttons stay visible in a narrow window -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,*">
            <Button Grid.Column="0" Content="Open triage…" Click="OnOpenTriage" />
            <Button Grid.Column="1" Content="Save triage" Click="OnSaveTriage" IsEnabled="{Binding IsTriageDirty}" Margin="8,0,0,0"
                    ToolTip.Tip="Writes the triage file to its path (Save as… for a new file)" />
            <Button Grid.Column="2" Content="Save triage as…" Click="OnSaveTriageAs" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding TriageText}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TriagePath}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}" IsVisible="{Binding IsRunning}" />
          <TextBlock Text="{Binding ProgressText}" Opacity="0.7" IsVisible="{Binding IsRunning}" TextWrapping="Wrap" />
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="Set up…" Click="OnOpenSettings" IsVisible="{Binding IsNotConfigured}"
                    Margin="0,0,8,0" VerticalAlignment="Top"
                    ToolTip.Tip="Opens the Settings tab: CytoGPS paths, cache and time limit (config/local.yaml)" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.8" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding TriageError}" Classes="invalid" IsVisible="{Binding HasTriageError}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MatrixText}" FontWeight="SemiBold" IsVisible="{Binding HasResult}" TextWrapping="Wrap" />
          <Expander Header="Stale triage entries (no longer a disagreement in this batch)" IsVisible="{Binding HasStaleTriage}">
            <ScrollViewer MaxHeight="140">
              <ItemsControl ItemsSource="{Binding StaleTriage}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="cmp:TriageEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Remove" Padding="6,0"
                              Command="{Binding $parent[ItemsControl].((vm:ComparisonViewModel)DataContext).RemoveStaleCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding Iscn}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Note}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </Border>
      <Expander DockPanel.Dock="Top" Header="Reader warnings" IsVisible="{Binding HasWarnings}" Margin="0,0,0,6">
        <ScrollViewer MaxHeight="120">
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>

      <!-- Summary per edition -->
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Summaries}" IsVisible="{Binding HasResult}" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Filter + open -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6" IsVisible="{Binding HasResult}">
        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="220">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BatchFilterChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Open in single-string check" Command="{Binding OpenSelectedCommand}"
                ToolTip.Tip="Or double-click a row" />
        <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{Binding Rows.Count, StringFormat='{}{0} row(s)'}" />
      </StackPanel>

      <!-- Table header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="60,90,2*,Auto,Auto,Auto,*" Margin="4,0,4,2" IsVisible="{Binding HasResult}">
        <TextBlock Grid.Column="0" Text="Line" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="ID" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="ISCN string" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="Corrected" FontWeight="SemiBold" Width="240" IsVisible="{Binding HasCorrectedRows}" />
        <ItemsControl Grid.Column="4" ItemsSource="{Binding Editions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='ISCN {0}'}" Width="90" FontWeight="SemiBold" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="5" Orientation="Horizontal" IsVisible="{Binding Comparison.HasResult}">
          <TextBlock Text="CytoGPS" Width="100" FontWeight="SemiBold" ToolTip.Tip="Agreement with CytoGPS (ISCN 2016; with autocorrection when Autocorrect is ticked)" />
          <TextBlock Text="Triage" Width="150" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Column="6" Text="First problem" FontWeight="SemiBold" Margin="8,0,0,0" />
      </Grid>

      <!-- Comparison detail of the selected row (T-052): CytoLex | CytoGPS, triage editor -->
      <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0"
              IsVisible="{Binding SelectedRow.Comparison.HasItem, FallbackValue=False}">
        <StackPanel Spacing="6" DataContext="{Binding SelectedRow.Comparison}" x:DataType="vm:ComparisonRowViewModel">
          <TextBlock Text="{Binding AgreementTip}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding CytoLexText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding CytoLexRules}" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="{Binding CheckerText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding CheckerDetails}" TextWrapping="Wrap" Opacity="0.85"
                                   FontFamily="Cascadia Mono,Consolas,monospace" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDisagreement}">
            <TextBlock Text="Triage:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{x:Static vm:ComparisonRowViewModel.Labels}" SelectedItem="{Binding EditLabel}" MinWidth="170"
                      PlaceholderText="label">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TriageLabelChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="Confirmed" IsChecked="{Binding EditConfirmed}" ToolTip.Tip="A person checked the label" />
            <TextBox Text="{Binding EditNote}" Width="420" PlaceholderText="Note (why the tools disagree)" />
            <Button Content="Apply" Command="{Binding ApplyTriageCommand}" ToolTip.Tip="Writes the entry into the triage file (then Save)" />
            <Button Content="Remove" Command="{Binding RemoveTriageCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Rows (virtualised) -->
      <ListBox x:Name="BatchRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
               IsVisible="{Binding HasResult}" DoubleTapped="OnBatchRowDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BatchRowViewModel">
            <Grid ColumnDefinitions="60,90,2*,Auto,Auto,Auto,*">
              <TextBlock Grid.Column="0" Text="{Binding Line}" Opacity="0.7" />
              <TextBlock Grid.Column="1" Text="{Binding Id}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Input}" FontFamily="Cascadia Mono,Consolas,monospace"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Input}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Text="{Binding Corrected}" Width="240" FontFamily="Cascadia Mono,Consolas,monospace"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CorrectedTip}" Margin="0,0,8,0"
                         IsVisible="{Binding $parent[ListBox].((vm:BatchViewModel)DataContext).HasCorrectedRows}" />
              <ItemsControl Grid.Column="4" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BatchCellViewModel">
                    <TextBlock Text="{Binding Text}" Width="90" ToolTip.Tip="{Binding Tip}"
                               Classes.valid="{Binding IsValid}" Classes.invalid="{Binding IsInvalid}" Classes.notimpl="{Binding IsNotImplemented}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Grid.Column="5" Orientation="Horizontal"
                          IsVisible="{Binding $parent[ListBox].((vm:BatchViewModel)DataContext).Comparison.HasResult}">
                <TextBlock Text="{Binding Comparison.AgreementText}" Width="100" ToolTip.Tip="{Binding Comparison.AgreementTip}"
                           Classes.valid="{Binding Comparison.IsAgreement}" Classes.invalid="{Binding Comparison.IsDisagreement}" />
                <TextBlock Text="{Binding Comparison.TriageText}" Width="150" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Comparison.Item.Triage.Note}" />
              </StackPanel>
              <TextBlock Grid.Column="6" Text="{Binding FirstProblem}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding FirstProblem}" Margin="8,0,0,0" Opacity="0.85" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </TabItem>

  <TabItem Header="Rules">
    <DockPanel Margin="8" DataContext="{Binding Rules}" x:DataType="vm:RuleBrowserViewModel">
      <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Classes="invalid"
                 TextWrapping="Wrap" Margin="0,0,0,8" />
      <!-- Search, edition, section -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding IsAvailable}">
        <TextBox Grid.Column="0" Text="{Binding Query}"
                 PlaceholderText="Search rules and symbols: ID, words, example strings like t(9;22), quotes, a symbol like del or →" />
        <ComboBox Grid.Column="1" MinWidth="120" Margin="8,0,0,0" ToolTip.Tip="ISCN edition"
                  ItemsSource="{Binding Editions}" SelectedItem="{Binding SelectedEdition}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='ISCN {0}'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="2" MinWidth="140" Margin="8,0,0,0" ToolTip.Tip="Book section"
                  ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="3" Text="{Binding ResultText}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
      </Grid>

      <Grid ColumnDefinitions="2*,Auto,3*" IsVisible="{Binding IsAvailable}">
        <!-- Hits -->
        <ListBox Grid.Column="0" ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RuleHitViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <Border Grid.Column="0" Background="{Binding SeverityBrush}" Width="4" CornerRadius="2" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Opacity="0.75" />
                  <TextBlock Text="{Binding Meta}" FontSize="12" Opacity="0.6" />
                  <TextBlock Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}" FontSize="12" FontStyle="Italic"
                             Opacity="0.75" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

        <!-- Detail -->
        <TextBlock Grid.Column="2" Text="Select a rule or symbol, or click a diagnostic's rule ID or a translation link in the single-string check."
                   Opacity="0.6" TextWrapping="Wrap" Margin="8,0,0,0">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!HasDetail" />
              <Binding Path="!HasVocabDetail" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
        <!-- Vocab item detail (T-059): a symbol, abbreviation or banding code -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasVocabDetail}">
          <StackPanel Margin="8,0,8,8" Spacing="8" DataContext="{Binding VocabDetail}" x:DataType="vm:VocabDetailViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="{x:Static vm:VocabDetailViewModel.KindBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Kind}" Foreground="White" />
              </Border>
              <SelectableTextBlock Text="{Binding Id}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Header}" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel Spacing="2">
              <TextBlock Text="Meanings" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Meanings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding TokensText}" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
            <TextBlock Text="{Binding Citation}" FontSize="12" Opacity="0.75" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasDetail}">
          <StackPanel Margin="8,0,8,8" Spacing="8" DataContext="{Binding Detail}" x:DataType="vm:RuleDetailViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="{Binding SeverityBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Severity}" Foreground="White" />
              </Border>
              <SelectableTextBlock Text="{Binding Id}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Header}" Opacity="0.7" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding Statement}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Citations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" Opacity="0.75" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="{Binding Fix}" IsVisible="{Binding HasFix}" TextWrapping="Wrap" Opacity="0.85" />
            <!-- T-097: rules whose fix is applied by autocorrection (KB fix.auto) -->
            <Border Classes="tag" IsVisible="{Binding IsAutoCorrected}" HorizontalAlignment="Left"
                    ToolTip.Tip="KB fix.auto: this fix is applied automatically when Autocorrect is on; the original is kept">
              <TextBlock Text="Autocorrected (fix.auto)" FontSize="12" />
            </Border>
            <TextBlock Text="{Binding Review}" IsVisible="{Binding HasReview}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />

            <StackPanel Spacing="2" IsVisible="{Binding HasRelated}">
              <TextBlock Text="Related rules" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Related}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RelatedRuleViewModel">
                    <Button Classes="link" Content="{Binding Id}" Command="{Binding OpenCommand}" Margin="0,0,12,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasValidExamples}">
              <TextBlock Text="Valid examples" FontWeight="SemiBold" Classes="valid" />
              <ItemsControl ItemsSource="{Binding ValidExamples}" ItemTemplate="{StaticResource RuleExampleTemplate}" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasInvalidExamples}">
              <TextBlock Text="Invalid examples" FontWeight="SemiBold" Classes="invalid" />
              <ItemsControl ItemsSource="{Binding InvalidExamples}" ItemTemplate="{StaticResource RuleExampleTemplate}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Source quotes" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static vm:RuleDetailViewModel.NoQuotesText}" IsVisible="{Binding !HasQuotes}" Opacity="0.6" />
              <ItemsControl ItemsSource="{Binding Quotes}" IsVisible="{Binding HasQuotes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rules:RuleQuote">
                    <Border BorderBrush="#808080" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic" />
                        <TextBlock Text="{Binding Citation}" FontSize="12" Opacity="0.7" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </TabItem>
  <!-- Band browser (T-084): the edition's bands, indented by nesting, with filters and the band detail -->
  <TabItem Header="Bands">
    <DockPanel Margin="8" DataContext="{Binding Bands}" x:DataType="vm:BandBrowserViewModel">
      <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Classes="invalid"
                 TextWrapping="Wrap" Margin="0,0,0,8" />
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding IsAvailable}">
        <TextBox Grid.Column="0" Text="{Binding Query}" PlaceholderText="Band name or its start: 5q13, 5q1, Xp22" />
        <ComboBox Grid.Column="1" MinWidth="120" Margin="8,0,0,0" ToolTip.Tip="ISCN edition"
                  ItemsSource="{Binding Editions}" SelectedItem="{Binding SelectedEdition}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='ISCN {0}'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="2" MinWidth="150" Margin="8,0,0,0" ToolTip.Tip="Chromosome"
                  ItemsSource="{Binding Chromosomes}" SelectedItem="{Binding SelectedChromosome}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChromosomeChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="3" MinWidth="140" Margin="8,0,0,0" ToolTip.Tip="Band level: only the band names that exist at this resolution"
                  ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LevelChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Grid.Column="4" Margin="12,0,0,0" Content="Not in the book only" IsChecked="{Binding NotInBookOnly}"
                  ToolTip.Tip="Genome-assembly bands that the book's idiograms don't show, kept valid by a band decision" />
        <TextBlock Grid.Column="5" Text="{Binding ResultText}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
      </Grid>

      <Grid ColumnDefinitions="2*,Auto,3*" IsVisible="{Binding IsAvailable}">
        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BandRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}">
                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                <Border Classes="tag" IsVisible="{Binding IsNotInBook}" VerticalAlignment="Center"
                        ToolTip.Tip="Not in the book's idiograms: a genome-assembly band kept valid by a band decision">
                  <TextBlock Text="not in the book" FontSize="11" />
                </Border>
                <Border Classes="tag" IsVisible="{Binding HasNoCoordinates}" VerticalAlignment="Center"
                        ToolTip.Tip="Printed in the book's idiograms, without NCBI coordinates">
                  <TextBlock Text="no coordinates" FontSize="11" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

        <TextBlock Grid.Column="2" Text="Select a band, or click a band link in the single-string check's translation."
                   Opacity="0.6" TextWrapping="Wrap" Margin="8,0,0,0" IsVisible="{Binding !HasDetail}" />
        <!-- Band detail (T-084): levels, stain, book status, coordinates, parent/sub-bands, cited band exceptions -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasDetail}">
          <StackPanel Margin="8,0,8,8" Spacing="8" DataContext="{Binding Detail}" x:DataType="vm:BandDetailViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="{x:Static vm:BandDetailViewModel.KindBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="band" Foreground="White" />
              </Border>
              <SelectableTextBlock Text="{Binding Id}" FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" FontFamily="Cascadia Mono,Consolas,monospace" />
            <TextBlock Text="{Binding Header}" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LevelsText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StainText}" IsVisible="{Binding HasStain}" Opacity="0.85" />
            <TextBlock Text="{Binding BookText}" IsVisible="{Binding HasBookText}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.85" />
            <StackPanel Spacing="2">
              <TextBlock Text="Coordinates (approximate)" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Coordinates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasParent}">
              <TextBlock Text="Part of" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Classes="link" Content="{Binding Parent.Name, FallbackValue=''}" Command="{Binding Parent.OpenCommand, FallbackValue={x:Null}}" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding HasChildren}">
              <TextBlock Text="Sub-bands" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Children}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BandLinkViewModel">
                    <Button Classes="link" Content="{Binding Name}" Command="{Binding OpenCommand}" Margin="0,0,12,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasExceptions}">
              <TextBlock Text="Book vs. NCBI decisions" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Exceptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BandDecisionViewModel">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                      <SelectableTextBlock Text="{Binding Names}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Citation}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </TabItem>
  <!-- Settings (T-089): the cytogps section of config/local.yaml; per-field checks, test run, save without restart -->
  <TabItem Header="Settings">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" DataContext="{Binding CytoGpsSettings}" x:DataType="vm:CytoGpsSettingsViewModel">
      <StackPanel Margin="12,8,20,12" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="External checkers · CytoGPS" FontWeight="SemiBold" FontSize="16" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Optional: a local CytoGPS build for comparison (ISCN 2016). Runs locally only; CytoLex validation never depends on it. Saving writes the cytogps section of config/local.yaml and keeps every other line." />
        <TextBlock Text="{Binding FileText}" Opacity="0.7" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace" />
        <Border Classes="banner" IsVisible="{Binding HasReadOnlyReason}">
          <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
        </Border>

        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingFieldViewModel">
              <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Key}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}"
                         FontFamily="Cascadia Mono,Consolas,monospace" PlaceholderText="{Binding Key}" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseSetting"
                        IsVisible="{Binding HasPicker}" IsEnabled="{Binding CanBrowse}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OverrideText}" IsVisible="{Binding IsOverridden}"
                           FontSize="12" TextWrapping="Wrap" Foreground="#CA5010" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasStatus}">
                  <TextBlock Text="✓" Classes="valid" IsVisible="{Binding IsOk}" />
                  <TextBlock Text="✗" Classes="invalid" IsVisible="{Binding IsProblem}" />
                  <SelectableTextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Disk cache" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="disk_cache" />
          <CheckBox Grid.Row="0" Grid.Column="1" Content="Also cache results on disk" IsChecked="{Binding DiskCache}"
                    IsEnabled="{Binding CanEditDiskCache}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static vm:CytoGpsSettingsViewModel.DiskCacheNote}" Opacity="0.7"
                     FontSize="12" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiskCacheOverrideText}" IsVisible="{Binding IsDiskCacheOverridden}"
                     FontSize="12" TextWrapping="Wrap" Foreground="#CA5010" />
        </Grid>

        <Grid ColumnDefinitions="150,120,*" RowDefinitions="Auto,Auto,Auto" DataContext="{Binding TimeoutSeconds}" x:DataType="vm:SettingFieldViewModel">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding Key}" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="600" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Hint}" Opacity="0.6" FontSize="12" Margin="8,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OverrideText}" IsVisible="{Binding IsOverridden}"
                     FontSize="12" TextWrapping="Wrap" Foreground="#CA5010" />
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                     Classes="invalid" FontSize="12" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Text="{Binding SetupText}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Classes.valid="{Binding IsSetupOk}" Classes.invalid="{Binding !IsSetupOk}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save" Command="{Binding SaveCommand}"
                  ToolTip.Tip="Writes the changed keys to config/local.yaml; the CytoGPS tab and the batch comparison pick them up at once" />
          <Button Content="Revert" Command="{Binding RevertCommand}" ToolTip.Tip="Drops the edits and reads the file again" />
          <Button Content="Test" Command="{Binding TestCommand}"
                  ToolTip.Tip="Runs the ISCN book string 47,XY,+21 through CytoGPS with the values as typed (not saved); the first run compiles CytoGPS" />
          <Button Content="Cancel test" Command="{Binding TestCancelCommand}" IsVisible="{Binding TestCommand.IsRunning}" />
        </StackPanel>
        <TextBlock Text="{Binding TestProgress}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding TestCommand.IsRunning}" />
        <SelectableTextBlock Text="{Binding TestResult}" IsVisible="{Binding HasTestResult}" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                             Classes.failed="{Binding IsTestFailed}" />
        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
                   Classes.invalid="{Binding IsStatusError}" />
      </StackPanel>
    </ScrollViewer>
  </TabItem>
  </TabControl>

  <Window.Resources>
    <!-- A KB example in the rule browser: the string, why/corrected/citation, and "Check" (T-039) -->
    <DataTemplate x:Key="RuleExampleTemplate" x:DataType="vm:RuleExampleViewModel">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <StackPanel Grid.Column="0" Spacing="1">
          <SelectableTextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Info}" IsVisible="{Binding HasInfo}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="link" Content="Check" Command="{Binding CheckCommand}" VerticalAlignment="Top"
                Margin="8,0,0,0" ToolTip.Tip="Open in the single-string check" />
      </Grid>
    </DataTemplate>

    <!-- One locus of the Map's list (T-101): click selects its span, hover marks it in the editor and on the ideogram -->
    <DataTemplate x:Key="LocusRowTemplate" x:DataType="vm:LocusItemViewModel">
      <Border Classes="locus" Classes.highlighted="{Binding IsHighlighted}" Classes.selected="{Binding IsSelected}"
              Tapped="OnSpanItemTapped" PointerEntered="OnLocusPointerEntered" PointerExited="OnLocusPointerExited"
              ToolTip.Tip="{Binding Tip}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Background="{Binding Brush}" CornerRadius="3" Padding="5,0" VerticalAlignment="Top"
                  Margin="0,1,6,0" MinWidth="44">
            <TextBlock Text="{Binding EffectLabel}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="0">
            <TextBlock Text="{Binding Place}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The summary or one part of a translation (T-059): text, sentence, readings, KB links, diagnostics, coordinates -->
    <DataTemplate x:Key="TranslationItemTemplate" x:DataType="vm:TranslationItemViewModel">
      <Border Classes="card" Classes.highlighted="{Binding IsHighlighted}" Classes.summary="{Binding IsSummary}"
              Opacity="{Binding Opacity}"
              Tapped="OnSpanItemTapped" PointerEntered="OnTranslationPointerEntered" PointerExited="OnTranslationPointerExited">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Text}" IsVisible="{Binding HasText}" FontFamily="Cascadia Mono,Consolas,monospace"
                     TextWrapping="Wrap" Opacity="0.8" />
          <SelectableTextBlock Text="{Binding Sentence}" FontStyle="{Binding SentenceStyle}" TextWrapping="Wrap"
                               Classes.summarytext="{Binding IsSummary}" />
          <StackPanel Spacing="1" IsVisible="{Binding HasReadings}" Margin="8,0,0,0">
            <SelectableTextBlock Text="{Binding ConstitutionalReading}" TextWrapping="Wrap" FontSize="13" />
            <SelectableTextBlock Text="{Binding AcquiredReading}" TextWrapping="Wrap" FontSize="13" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding Composition}" IsVisible="{Binding HasComposition}" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.7" />
          <ItemsControl ItemsSource="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticLinkViewModel">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
                  <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                  <Button Classes="link" Content="{Binding Label}" Command="{Binding SelectCommand}" FontSize="12"
                          ToolTip.Tip="{Binding Tip}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KbLinkViewModel">
                <Panel Margin="0,0,6,4">
                  <Button Classes="link kblink" Content="{Binding Title}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Tip}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding CoordinateLines}" IsVisible="{Binding HasCoordinates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Text="{Binding}" FontSize="11" Opacity="0.75" FontFamily="Cascadia Mono,Consolas,monospace" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- One run of a fix diff (T-040): removed text red and struck through, added text green -->
    <DataTemplate x:Key="DiffPartTemplate" x:DataType="vm:DiffPartViewModel">
      <Border Classes="diff" Classes.removed="{Binding IsRemoved}" Classes.added="{Binding IsAdded}" CornerRadius="2">
        <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="14" />
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- Fix diff runs (T-040); colours in DiffBrushes -->
    <Style Selector="Border.diff.removed">
      <Setter Property="Background" Value="{x:Static hl:DiffBrushes.Removed}" />
    </Style>
    <Style Selector="Border.diff.removed > TextBlock">
      <Setter Property="Foreground" Value="{x:Static hl:DiffBrushes.OnChange}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Border.diff.added">
      <Setter Property="Background" Value="{x:Static hl:DiffBrushes.Added}" />
    </Style>
    <Style Selector="Border.diff.added > TextBlock">
      <Setter Property="Foreground" Value="{x:Static hl:DiffBrushes.OnChange}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#0078D4" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- A translation's KB link (T-059): a small pill in the normal font, several per line -->
    <Style Selector="Button.link.kblink">
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#550078D4" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#005A9E" />
    </Style>
    <Style Selector="TextBlock.valid">
      <Setter Property="Foreground" Value="#107C10" />
    </Style>
    <Style Selector="TextBlock.autocorrected">
      <Setter Property="Foreground" Value="#498205" />
    </Style>
    <Style Selector="Border.corrected">
      <Setter Property="BorderBrush" Value="#9A9A9A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="TextBlock.invalid">
      <Setter Property="Foreground" Value="#D13438" />
    </Style>
    <Style Selector="TextBlock.notimpl">
      <Setter Property="Foreground" Value="#808080" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="#808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- T-101: a card marked by a selection on the Map; a locus row highlighted or selected -->
    <Style Selector="Border.card.marked">
      <Setter Property="BorderBrush" Value="#0078D4" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.locus">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.locus:pointerover, Border.locus.highlighted">
      <Setter Property="Background" Value="#22FFC800" />
    </Style>
    <Style Selector="Border.locus.selected">
      <Setter Property="BorderBrush" Value="#0078D4" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="#0078D4" />
    </Style>
    <!-- Result columns (T-059): diagnostics | abnormalities/translation as two full-height panels with aligned 36 px headers -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="#40808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Edition chips (T-098) -->
    <Style Selector="ListBox.chips">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips > ListBoxItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="#60808080" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.chips > ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="#0078D4" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- View tabs (T-098) -->
    <Style Selector="TabControl#ViewTabs > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- Translation (T-059): the part at the mouse in the editor, the summary card, the partial-translation banner -->
    <Style Selector="Border.card.highlighted">
      <Setter Property="BorderBrush" Value="#0078D4" />
      <Setter Property="Background" Value="#220078D4" />
    </Style>
    <Style Selector="Border.card.summary">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="SelectableTextBlock.summarytext">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="#33C42B1C" />
      <Setter Property="BorderBrush" Value="#C42B1C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="#200078D4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,4,2" />
    </Style>
    <Style Selector="Border.flag">
      <Setter Property="BorderBrush" Value="#808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Border.part">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- CytoGPS agreement badge (T-081) -->
    <Style Selector="Border.agreement">
      <Setter Property="Background" Value="#20808080" />
      <Setter Property="BorderBrush" Value="#808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.agreement.agree">
      <Setter Property="Background" Value="#20107C10" />
      <Setter Property="BorderBrush" Value="#107C10" />
    </Style>
    <Style Selector="Border.agreement.disagree">
      <Setter Property="Background" Value="#33CA5010" />
      <Setter Property="BorderBrush" Value="#CA5010" />
    </Style>
    <!-- Settings (T-089): a test run without a verdict -->
    <Style Selector="SelectableTextBlock.failed">
      <Setter Property="Foreground" Value="#D13438" />
    </Style>
    <Style Selector="Border.part:pointerover">
      <Setter Property="Background" Value="#200078D4" />
    </Style>
  </Window.Styles>
</Window>
