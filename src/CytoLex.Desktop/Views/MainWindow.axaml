<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vm="using:CytoLex.Desktop.ViewModels"
        x:Class="CytoLex.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CytoLex"
        Width="900" Height="500">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="ISCN string" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.7" />
    <Border BorderBrush="Gray" BorderThickness="1">
      <ae:TextEditor x:Name="Input" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="15"
                     ShowLineNumbers="False" WordWrap="True" />
    </Border>
  </DockPanel>
</Window>
