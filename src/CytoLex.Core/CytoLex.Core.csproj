<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI-free core library: parsing, validation, fixes (docs/design/core.md). -->
  <PropertyGroup>
    <RootNamespace>CytoLex.Core</RootNamespace>
    <!-- Lean runtime KB bundle embedded at build time (docs/design/core.md §6; written by
         `kb build`, T-060). Override with -p:CytoLexKbBundle=<path>. -->
    <CytoLexKbBundle Condition="'$(CytoLexKbBundle)' == ''">$(RepoRoot)build/kb-runtime.json</CytoLexKbBundle>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(CytoLexKbBundle)" LogicalName="CytoLex.Kb.bundle.json" Visible="false" />
    <InternalsVisibleTo Include="CytoLex.Core.Tests" />
  </ItemGroup>

  <Target Name="CheckKbBundle" BeforeTargets="BeforeBuild;PrepareResources">
    <Error Condition="!Exists('$(CytoLexKbBundle)')"
           Text="KB bundle not found: $(CytoLexKbBundle). Run 'uv run --directory tools kb build' from the repo root first." />
  </Target>
</Project>
