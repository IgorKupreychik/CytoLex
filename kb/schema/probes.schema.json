{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytolex.local/schema/probes.schema.json",
  "title": "CytoLex — one row of the probe table (curated/probes/probes.csv)",
  "description": "A probe/locus row (T-102). Every cell is text; empty optional cells are empty strings. Row-level checks that need the band data (band exists, band vs coordinates, builds agree, duplicates, date-mangled names) are done by `kb build`. Editing guide: curated/probes/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["probe", "aliases", "kind", "chromosome", "band", "grch37", "grch38", "source", "reviewed", "reviewer", "date", "note"],
  "properties": {
    "probe": { "type": "string", "minLength": 1, "pattern": "^\\S+$", "x-expected": "a probe name without spaces" },
    "aliases": { "type": "string", "pattern": "^$|^[^;\\s]+(;[^;\\s]+)*$", "x-expected": "names separated by ';' (no spaces)" },
    "kind": { "type": "string", "enum": ["gene", "centromere", "clone", "paint", "commercial", "other"] },
    "chromosome": { "type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)$", "x-expected": "a chromosome 1-22, X or Y" },
    "band": { "type": "string", "pattern": "^$|^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][0-9]+(\\.[0-9]+)?(-[pq][0-9]+(\\.[0-9]+)?)?$", "x-expected": "a band such as 9q34.12, or a range such as 22q11.21-q11.22" },
    "grch37": { "$ref": "#/$defs/range" },
    "grch38": { "$ref": "#/$defs/range" },
    "source": { "type": "string", "minLength": 1 },
    "reviewed": { "type": "string", "enum": ["yes", "no"] },
    "reviewer": { "type": "string" },
    "date": { "type": "string", "pattern": "^$|^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "x-expected": "a date YYYY-MM-DD" },
    "note": { "type": "string" }
  },
  "if": { "properties": { "reviewed": { "const": "yes" } } },
  "then": {
    "properties": {
      "reviewer": { "minLength": 1 },
      "date": { "minLength": 1 }
    }
  },
  "$defs": {
    "range": { "type": "string", "pattern": "^$|^[0-9]+-[0-9]+$", "x-expected": "start-end in bp, e.g. 130713946-130887675" }
  }
}
