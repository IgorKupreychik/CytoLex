{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytolex.local/schema/rules.schema.json",
  "title": "CytoLex KB — rule file",
  "description": "One file per ISCN section: curated/rules/<version>/chNN/<section-slug>.yaml. Conventions: kb/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "section", "rules"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "section": { "$ref": "common.schema.json#/$defs/section" },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "applies_to", "severity", "statement", "cite", "examples", "review"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/rule_id" },
        "title": { "description": "Short name for lists and the rule browser.", "$ref": "common.schema.json#/$defs/text" },
        "applies_to": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/applies_to" }
        },
        "context": {
          "description": "Omitted = applies in every context.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/context" }
        },
        "severity": { "$ref": "common.schema.json#/$defs/severity" },
        "statement": { "description": "Paraphrase of the book's rule (not a verbatim quote).", "$ref": "common.schema.json#/$defs/text" },
        "cite": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/cite" }
        },
        "examples": { "$ref": "#/$defs/examples" },
        "fix": { "$ref": "#/$defs/fix" },
        "review": { "$ref": "#/$defs/review" },
        "related": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/rule_id" }
        }
      }
    },
    "examples": {
      "description": "Doubles as the validator/fixer test suite. Book examples go in 'valid' with their En cite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "type": "array", "items": { "$ref": "#/$defs/valid_example" } },
        "invalid": { "type": "array", "items": { "$ref": "#/$defs/invalid_example" } }
      }
    },
    "valid_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "common.schema.json#/$defs/text" },
        "cite": { "description": "Set for book examples.", "$ref": "common.schema.json#/$defs/cite" },
        "note": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "invalid_example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "why"],
      "properties": {
        "text": { "$ref": "common.schema.json#/$defs/text" },
        "why": { "description": "Which part breaks the rule and how.", "$ref": "common.schema.json#/$defs/text" },
        "corrected": { "description": "The valid form, when there is exactly one.", "$ref": "common.schema.json#/$defs/text" },
        "cite": { "description": "Set when the book itself shows the wrong form.", "$ref": "common.schema.json#/$defs/cite" }
      }
    },
    "fix": {
      "description": "Level 1: deterministic edit (diff + Apply). Level 3: explanation only, no single fix.",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "hint"],
      "properties": {
        "level": { "enum": [1, 3] },
        "kind": { "enum": ["replace", "insert", "delete", "reorder"] },
        "hint": { "$ref": "common.schema.json#/$defs/text" },
        "auto": {
          "description": "Autocorrection (T-096): the validator may apply this rule's level-1 fixes automatically. Only for fixes that keep the meaning, have a single alternative and don't depend on the sample context.",
          "type": "boolean"
        }
      },
      "if": { "properties": { "level": { "const": 1 } } },
      "then": { "required": ["kind"] },
      "else": { "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["auto"] }] } }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paraphrase_checked", "needs_review"],
      "properties": {
        "paraphrase_checked": { "description": "A person approved the statement against the quote.", "type": "boolean" },
        "needs_review": { "description": "Ambiguous in the book or affected by extraction loss (docs/extraction-review-<version>.md).", "type": "boolean" },
        "note": { "$ref": "common.schema.json#/$defs/text" }
      },
      "if": { "properties": { "needs_review": { "const": true } } },
      "then": { "required": ["note"] }
    }
  }
}
