{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytolex.local/schema/associations.schema.json",
  "title": "CytoLex — association rules (curated/associations/associations.yaml)",
  "description": "Conditions associated in the literature with abnormalities (T-104, T-108). Edition-independent and person-maintained. Checks that need the band data (bands exist in every edition, copy regions vs bands, unique IDs) are done by `kb build`. Editing guide: curated/associations/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["associations"],
  "properties": {
    "associations": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "chrom": { "type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)$", "x-expected": "a chromosome 1-22, X or Y" },
    "band": {
      "type": "string",
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][0-9]+(\\.[0-9]+)?$",
      "x-expected": "a full band name such as 9q34 or 22q11.21"
    },
    "source": { "enum": ["WHO-HAEM5", "ICC-2022", "ClinGen", "Orphanet", "other"] },
    "text": { "type": "string", "minLength": 1 },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "context", "strength", "source", "citation", "match", "review"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/rule_id" },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/text" },
            "ids": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["system", "code"],
                "properties": {
                  "system": { "enum": ["orphanet", "icd10", "icdo3", "mondo", "other"] },
                  "code": { "$ref": "#/$defs/text" }
                }
              }
            }
          }
        },
        "context": { "enum": ["constitutional", "neoplastic", "any"] },
        "strength": { "enum": ["characteristic", "recurrent", "reported"] },
        "defining": {
          "description": "The classifications that make the abnormality a defining criterion of the condition (kept for a later diagnosis mode, T-112).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "citation"],
            "properties": {
              "source": { "$ref": "#/$defs/source" },
              "citation": { "$ref": "#/$defs/text" }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "citation": { "description": "Section of the classification or dataset version, in own words (facts only, no copied text).", "$ref": "#/$defs/text" },
        "match": { "$ref": "#/$defs/node" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed"],
          "properties": {
            "reviewed": { "type": "boolean" },
            "reviewer": { "type": "string" },
            "date": { "type": "string", "pattern": "^$|^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$", "x-expected": "a date YYYY-MM-DD" },
            "note": { "type": "string" }
          },
          "if": { "properties": { "reviewed": { "const": true } } },
          "then": {
            "required": ["reviewer", "date"],
            "properties": { "reviewer": { "minLength": 1 }, "date": { "minLength": 1 } }
          }
        }
      }
    },
    "node": {
      "description": "Exactly one of: exact, fusion, copy (leaves); all, any, not (combinators).",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "exact": {
          "description": "An abnormality's short form, e.g. +21, t(9;22)(q34;q11.2), inv(16)(p13.1q22). Band-level tolerant: q11.2 also matches q11.21.",
          "type": "string",
          "pattern": "^([+-]([1-9]|1[0-9]|2[0-2]|X|Y)|[a-z]+\\(([1-9]|1[0-9]|2[0-2]|X|Y)(;([1-9]|1[0-9]|2[0-2]|X|Y))*\\)(\\(([pq][0-9]+(\\.[0-9]+)?|cen|pter|qter)+(;([pq][0-9]+(\\.[0-9]+)?|cen|pter|qter)+)*\\))?)$",
          "x-expected": "a short form such as +21, del(5)(q13q33) or t(9;22)(q34;q11.2)"
        },
        "fusion": {
          "description": "Two bands joined by any rearrangement (including ish con).",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/band" }
        },
        "copy": {
          "description": "A gain or loss overlapping a GRCh38 region.",
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "chrom", "grch38"],
          "properties": {
            "effect": { "enum": ["gain", "loss"] },
            "chrom": { "$ref": "#/$defs/chrom" },
            "grch38": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": 1 }
            },
            "band": {
              "type": "string",
              "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][0-9]+(\\.[0-9]+)?(-[pq][0-9]+(\\.[0-9]+)?)?$",
              "x-expected": "a band such as 22q11.21, or a range such as 22q11.21-q11.23"
            }
          }
        },
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "not": { "$ref": "#/$defs/node" }
      }
    }
  }
}
