{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytolex.local/schema/quotes.schema.json",
  "title": "CytoLex KB — verbatim quote file",
  "description": "Same relative path as the rule file, under kb/source-quotes/<version>/. Removable before public release (T-043).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "section", "quotes"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "section": { "$ref": "common.schema.json#/$defs/section" },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "cite", "text"],
        "properties": {
          "rule": { "$ref": "common.schema.json#/$defs/rule_id" },
          "cite": { "$ref": "common.schema.json#/$defs/cite" },
          "text": { "description": "Chunk text copied verbatim (labels excluded).", "$ref": "common.schema.json#/$defs/text" }
        }
      }
    }
  }
}
